# ============================================================
# Korjournal – Miljövariabler
# Kopiera till .env och fyll i dina värden:  cp .env.example .env
# ============================================================

# === Server / portar ===
SERVER_HOST=192.168.1.100         # IP/hostname till maskinen där Docker kör
WEB_PORT=3001                     # publik port för webben
API_PORT=8080                     # publik port för API:t

# Origin appen nås på utifrån, genom nginx-proxyn. Används för CORS vid
# direkta API-anrop; webben själv går via /api på samma origin och behöver
# den inte. Lämna tom om appen bara körs på LAN.
PUBLIC_ORIGIN=https://korjournal.example.se

# === Applikation ===
SECRET_KEY=ändra_mig_till_minst_64_tecken_lång_slumpmässig_sträng_här_1234567890
# 43200 = 30 dagar. Kort livslängd betyder inloggningsruta varje gång iOS
# dödat PWA:n, vilket är ohållbart när appen ska användas stående vid bilen.
# Det finns ingen spärrlista för utfärdade tokens — byt SECRET_KEY för att
# ogiltigförklara allihop på en gång.
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ENV=development                   # development | production
COOKIE_SECURE=false               # true om HTTPS
COOKIE_SAMESITE=lax               # lax | strict | none

# === Admin (skapas automatiskt vid första start) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BytMig123!

# === Databas ===
# Tre alternativ – välj ETT:
#
# 1) EXTERN MariaDB (t.ex. NAS) – använd bara docker-compose.yml
#    Sätt NAS_DB_*-variablerna nedan.
#
# 2) LOKAL PostgreSQL i Docker – kör med:
#    docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d
#    Sätt DB_USER/DB_PASS nedan.
#
# 3) SQLite (ingen extra config) – kommentera bort DATABASE_URL i compose.
#    Bra för test/utveckling.

# -- Extern MariaDB (alternativ 1) --
NAS_DB_HOST=192.168.1.51
NAS_DB_PORT=3307
NAS_DB_NAME=korjournal
NAS_DB_USER=koruser
NAS_DB_PASS=ändra_mig

# -- Lokal PostgreSQL i Docker (alternativ 2) --
DB_NAME=korjournal
DB_USER=koruser
DB_PASS=ändra_mig

# === Home Assistant (valfritt – kan även konfigureras per användare i Settings) ===
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_ODOMETER_ENTITY=sensor.odometer
HA_FORCE_DOMAIN=kia_uvo
HA_FORCE_SERVICE=force_update
# Extra data till force-tjänsten som JSON. Nyare kia_uvo kräver device_id:
# HA_FORCE_DATA={"device_id":"<device_id från HA:s enhetsregister>"}
HA_VERIFY_SSL=true
